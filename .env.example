# Copy this file to .env and fill in your keys. Never commit .env.

# Anthropic (Claude seat)
ANTHROPIC_API_KEY=

# OpenAI (ChatGPT seat)
OPENAI_API_KEY=

# Optional: pin the models used for each seat (fill in the exact model IDs you want).
# Not yet read by any code — seat/model wiring lands in milestone 4 (config-driven
# personas); these are placeholders for that. Flagship defaults per docs/DECISIONS.md D11:
# CLAUDE_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5
CLAUDE_MODEL=
OPENAI_MODEL=

# Optional: path to the active orchestration policy config
POLICY_CONFIG=config/policy.json
